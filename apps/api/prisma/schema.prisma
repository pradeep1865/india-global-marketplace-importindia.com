generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  MANUFACTURER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING_EMAIL
  ACTIVE
  PENDING_ADMIN_APPROVAL
  LOCKED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  FULFILLED
  CANCELLED
  RETURNED
}

enum ShippingStatus {
  PENDING
  PACKED
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id               String          @id @default(cuid())
  role             UserRole
  email            String          @unique
  passwordHash     String          @map("password_hash")
  accountStatus    AccountStatus   @default(PENDING_EMAIL) @map("account_status")
  failedAttempts   Int             @default(0) @map("failed_attempts")
  emailVerifiedAt  DateTime?       @map("email_verified_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  buyer            Buyer?
  manufacturer     Manufacturer?
  addresses        Address[]
  searchHistory    SearchHistory[]
  contactMessages  ContactMessage[]
  notifications    Notification[]
  adminLogs        AdminLog[]      @relation("AdminActor")
  reviews          ManufacturerReview[]

  @@map("users")
}

model Buyer {
  userId     String     @id @map("user_id")
  fullName   String     @map("full_name")
  dob        DateTime?  @map("DOB")
  country    String
  location   String
  phone      String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
  cartItems  Cart[]
  wishlist   Wishlist[]

  @@map("buyers")
}

model Manufacturer {
  userId              String             @id @map("user_id")
  companyName         String             @map("company_name")
  registrationNumber  String             @unique @map("registration_number")
  verificationStatus  VerificationStatus @default(PENDING) @map("verification_status")
  companyPhone        String             @map("company_phone")
  companyCountry      String             @map("company_country")
  companyLocation     String             @map("company_location")
  verifiedAt          DateTime?          @map("verified_at")
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  products            Product[]
  pickupAddresses     PickupAddress[]
  reviews             ManufacturerReview[]

  @@map("manufacturers")
}

model Category {
  id           String    @id @default(cuid())
  categoryName String    @unique @map("category_name")
  products     Product[]

  @@map("categories")
}

model Product {
  id              String               @id @default(cuid())
  manufacturerId  String               @map("manufacturer_id")
  shortName       String               @map("short_name")
  description     String
  categoryId      String               @map("category_id")
  basePrice       Decimal              @db.Decimal(12, 2) @map("base_price")
  moq             Int                  @map("MOQ")
  availableDays   Int                  @map("available_days")
  stock           Int
  shippingWeight  Decimal?             @db.Decimal(10, 2) @map("shipping_weight")
  tags            String[]
  isPublished     Boolean              @default(false) @map("is_published")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  manufacturer    Manufacturer         @relation(fields: [manufacturerId], references: [userId])
  category        Category             @relation(fields: [categoryId], references: [id])
  media           ProductMedia[]
  pricingTiers    ProductPricingTier[]
  orderItems      OrderItem[]
  cartItems       Cart[]
  wishlist        Wishlist[]

  @@index([categoryId])
  @@index([manufacturerId])
  @@map("products")
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String    @map("product_id")
  imageUrl  String?   @map("image_url")
  videoUrl  String?   @map("video_url")
  mediaType MediaType @map("media_type")
  sortOrder Int       @default(0) @map("sort_order")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_media")
}

model ProductPricingTier {
  id       String  @id @default(cuid())
  productId String @map("product_id")
  moqLevel  Int    @map("MOQ_level")
  price     Decimal @db.Decimal(12, 2)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_pricing_tiers")
}

model Order {
  id             String         @id @default(cuid())
  buyerId        String         @map("buyer_id")
  orderStatus    OrderStatus    @default(PLACED) @map("order_status")
  shippingStatus ShippingStatus @default(PENDING) @map("shipping_status")
  paymentStatus  PaymentStatus  @default(PENDING) @map("payment_status")
  taxAmount      Decimal        @db.Decimal(12, 2) @map("tax_amount")
  shippingAmount Decimal        @db.Decimal(12, 2) @map("shipping_amount")
  totalAmount    Decimal        @db.Decimal(12, 2) @map("total_amount")
  createdAt      DateTime       @default(now()) @map("created_at")
  buyer          Buyer          @relation(fields: [buyerId], references: [userId])
  items          OrderItem[]
  returns        Return[]
  payments       Payment[]

  @@index([buyerId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2) @map("unit_price")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Cart {
  id        String  @id @default(cuid())
  buyerId   String  @map("buyer_id")
  productId String  @map("product_id")
  quantity  Int
  buyer     Buyer   @relation(fields: [buyerId], references: [userId], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buyerId, productId])
  @@map("cart")
}

model Address {
  id          String @id @default(cuid())
  userId      String @map("user_id")
  addressLine String @map("address_line")
  city        String
  state       String
  country     String
  zipCode     String @map("zip_code")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model PickupAddress {
  id             String       @id @default(cuid())
  manufacturerId String       @map("manufacturer_id")
  addressLine    String       @map("address_line")
  city           String
  state          String
  country        String
  zipCode        String       @map("zip_code")
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [userId], onDelete: Cascade)

  @@map("pickup_addresses")
}

model SearchHistory {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  keywords   String
  searchedAt DateTime @default(now()) @map("searched_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_history")
}

model Return {
  id           String @id @default(cuid())
  orderId      String @map("order_id")
  returnReason String @map("return_reason")
  returnStatus String @map("return_status")
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("returns")
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  subject   String
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contact_messages")
}

model AdminLog {
  id          String   @id @default(cuid())
  action      String
  performedBy String   @map("performed_by")
  timestamp   DateTime @default(now())
  metadata    Json?
  actor       User     @relation("AdminActor", fields: [performedBy], references: [id])

  @@map("admin_logs")
}

model Notification {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  notificationText String   @map("notification_text")
  isRead           Boolean  @default(false) @map("is_read")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @map("order_id")
  transactionId   String        @unique @map("transaction_id")
  paymentProvider String        @map("payment_provider")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  rawPayload       Json?         @map("raw_payload")
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Wishlist {
  id        String  @id @default(cuid())
  buyerId   String  @map("buyer_id")
  productId String  @map("product_id")
  buyer     Buyer   @relation(fields: [buyerId], references: [userId], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buyerId, productId])
  @@map("wishlist")
}

model ManufacturerReview {
  id             String       @id @default(cuid())
  manufacturerId String       @map("manufacturer_id")
  userId         String       @map("user_id")
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at")
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [userId], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("manufacturer_reviews")
}
